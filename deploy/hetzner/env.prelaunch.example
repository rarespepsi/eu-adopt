# Copiază în /opt/eu-adopt/.env pe Hetzner — nu comita acest fișier cu parole reale.

DJANGO_SECRET_KEY=INLOCUIESTE_CU_CHEIE_RANDOM
DJANGO_DEBUG=0
DJANGO_SECURE_SSL=1
DATABASE_URL=postgresql://euadopt:PAROLA@localhost:5432/euadopt

EUADOPT_SITE_BASE_URL=https://eu-adopt.ro

SITE_PUBLIC=1
EUADOPT_PRELAUNCH_MODE=1
EUADOPT_POPULATION_ONBOARDING=1
EUADOPT_POPULATION_SUPERUSER_ONLY=1
