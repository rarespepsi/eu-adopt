[Unit]
Description=EU-Adopt Gunicorn
After=network.target postgresql.service

[Service]
User=euadopt
Group=euadopt
WorkingDirectory=/opt/eu-adopt
EnvironmentFile=/opt/eu-adopt/.env
ExecStart=/opt/eu-adopt/venv/bin/gunicorn euadopt_final.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
