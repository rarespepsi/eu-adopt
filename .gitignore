# Local / secrets – do not commit
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.env

# Python bytecode / caches
__pycache__/
*.pyc

# Django generated / local runtime
staticfiles/
media/
.django_cache/

# Local DB (keep out of git to avoid noise)
db.sqlite3

# User export dumps (password hashes / PII) — never commit
user_migration_sqlite.json
**/user_migration_sqlite.json

# Playwright / Node (E2E)
node_modules/
playwright-report/
test-results/
playwright/.cache/
.env.e2e
.env.e2e.local

# Local snapshots/backups (keep only on disk)
_archive/project_snapshots/*.zip
_archive/project_snapshots/*.txt

# Copii DB / dump-uri locale (vezi database/README.md)
database/backups/**
!database/backups/.gitkeep
