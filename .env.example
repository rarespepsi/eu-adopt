# Copiază în `.env` și completează. Nu comita `.env`.

# Obligatoriu în producție: cheie aleatoare lungă (ex. `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`)
# DJANGO_SECRET_KEY=<pune_cheie_lunga_random_unica>

# Local: setează 1 pentru DEBUG. Producție: 0.
# DJANGO_DEBUG=0

# HTTPS / cookie-uri secure. Producție: 1 (recomandat).
# DJANGO_SECURE_SSL=1
# HSTS preload (pentru check --deploy). Lasă 1 în producție după confirmare că domeniul e strict HTTPS.
# DJANGO_HSTS_PRELOAD=1

# Opțional: hosturi extra (dev LAN etc.), separate prin virgulă.
# DJANGO_ALLOWED_HOSTS=192.168.1.100,192.168.0.5

# Producție Render/PostgreSQL: pune URL-ul DB (Internal Database URL din Render).
# Fără această variabilă, proiectul folosește sqlite local (`db.sqlite3`).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# URL absolut pentru linkuri în emailuri (fără slash final). În producție setează explicit
# (ex. pe Render), altfel risc de linkuri relative → http:/// în Gmail.
# EUADOPT_SITE_BASE_URL=https://www.eu-adopt.ro
# Hub EU: meniu/limbi — dezactivat în faza infra (implicit 0). Activează: EUADOPT_EU_PRODUCT_SKIN=1
# EUADOPT_EU_PRODUCT_SKIN=0
# Local SMTP: dacă deschizi linkul de activare de pe ALT device (telefon pe Wi‑Fi): IP LAN al PC‑ului:
# EUADOPT_SITE_BASE_URL_DEV=http://192.168.x.x:8000
# + ./manage.py runserver 0.0.0.0:8000
# Strict local pe același PC: EUADOPT_SITE_BASE_URL_DEV=http://127.0.0.1:8000

# SMTP Zoho Mail (EU-Adopt) — contact@eu-adopt.ro
# OBLIGATORIU pe Render (Environment): toate liniile de mai jos, altfel site-ul pornește dar emailurile nu se trimit.
# App Password (NU parola contului): Zoho Account → Security → App Passwords
# Copiază liniile în .env local sau în Render Dashboard → Environment; parola DOAR acolo, nu în git.
# EMAIL_HOST=smtppro.zoho.eu
# SSL (Zoho EU – folosit în producție): port 465
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# TLS alternativ: port 587 + EMAIL_USE_TLS=True + EMAIL_USE_SSL=False
# EMAIL_HOST_USER=contact@eu-adopt.ro
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=EU-Adopt Team <contact@eu-adopt.ro>
# Opțional: unde sosesc mesajele din formularul Contact (implicit = EMAIL_HOST_USER)
# CONTACT_NOTIFY_EMAIL=contact@eu-adopt.ro
# Raport zilnic invitații Add USER (09:00 RO, ziua anterioară)
# EUADOPT_STAFF_INVITE_REPORT_ENABLED=1
# STAFF_INVITE_REPORT_EMAIL=contact@eu-adopt.ro

# Add USER — Faza C: răspunsuri invitații (Reply-To invite+{id}@domeniu; necesită alias/catch-all Zoho)
# STAFF_INVITE_REPLY_LOCAL=invite
# IMAP (citire răspunsuri) — de obicei același cont Zoho:
# STAFF_INVITE_IMAP_HOST=imappro.zoho.eu
# STAFF_INVITE_IMAP_PORT=993
# STAFF_INVITE_IMAP_USER=contact@eu-adopt.ro
# STAFF_INVITE_IMAP_PASSWORD=
# Webhook opțional POST /admin-analysis/add-user/invite-inbound-webhook/ + header X-EUAdopt-Webhook-Secret
# STAFF_INVITE_INBOUND_WEBHOOK_SECRET=

# Google Maps pe /transport/ (browser — adesea restricție „HTTP referrers”)
# EUADOPT_GOOGLE_MAPS_API_KEY=
# Opțional: cheie pentru scripturi server (Places searchText, fără referrer gol). Dacă lipsește, se încearcă cheia de mai sus + fallback DuckDuckGo.
# EUADOPT_GOOGLE_PLACES_SERVER_API_KEY=

# Site public (0 = mod întreținere pe unele deploy-uri)
# SITE_PUBLIC=1

# PRE-LAUNCH: 1 = site accesibil doar după login (fără înregistrare publică). Lansare: 0 sau șters.
# EUADOPT_PRELAUNCH_MODE=0
# Publicitate + promovare A2 gratuite în pre-lansare (implicit = PRELAUNCH_MODE). Dezactivare: EUADOPT_PUBLICITATE_PRELAUNCH_FREE=0
# EUADOPT_PUBLICITATE_PRELAUNCH_FREE=1
# EUADOPT_PUB_MAX_SLOTS_PER_USER=1
# EUADOPT_PROMO_A2_MAX_PER_USER=1
# EUADOPT_COLLAB_MAX_OFFERS_PER_USER=1
# Blocare soft Shop/donații/plăți comerciale în pre-lansare (implicit = PRELAUNCH_MODE). Dezactivare: EUADOPT_PRELAUNCH_MONETIZATION_SOFT_LOCK=0
# EUADOPT_PRELAUNCH_MONETIZATION_SOFT_LOCK=1
# T₀ campanii: contor înregistrări/logări/lead-uri de la această dată (YYYY-MM-DD, 00:00 RO)
# EUADOPT_METRICS_T0=2026-07-13

# Populare adăpost/ONG — min/max animale, meniu redus (vezi docs/POPULARE_ADAPOST_ONG.md).
# Implicit activ când PRELAUNCH=1. Lansare: EUADOPT_POPULATION_ONBOARDING=0
# EUADOPT_POPULATION_ONBOARDING=1
# EUADOPT_POPULATION_SUPERUSER_ONLY=1
# EUADOPT_POPULATION_ANIMAL_MIN=2
# EUADOPT_POPULATION_ANIMAL_MAX=5

# Dev/QA: 1 = permite același email pe mai multe conturi (signup + pagina Cont). Producție: nu seta.
# EUADOPT_RELAX_EMAIL_UNIQUE=1

# SMS OTP (înregistrare + schimbare telefon). Local/dev: 0 → cod fix afișat pe ecran, fără cost SMS.
# EUADOPT_SMS_OTP_ENABLED=0
# EUADOPT_SMS_OTP_DEV_CODE=528419
# Producție: 1 + token OAuth din https://www.smsapi.ro (Client → API OAuth Tokens).
# EUADOPT_SMSAPI_TOKEN=
# Nume expeditor (trebuie aprobat în panou SMSAPI; la start poți lăsa EU-Adopt sau INFO).
# EUADOPT_SMSAPI_SENDER=EU-Adopt
# EUADOPT_SMSAPI_API_URL=https://api.smsapi.ro/

# Ghid site (nor FAQ + Gemini opțional). Local DEBUG=1 → activ implicit; producție: setează explicit.
# EUADOPT_SITE_GUIDE_ENABLED=1
# EUADOPT_SITE_GUIDE_ENABLED=0
# Fallback AI (opțional): 1 + cheie Google AI Studio
# EUADOPT_SITE_GUIDE_GEMINI_ENABLED=0
# EUADOPT_GEMINI_API_KEY=
# EUADOPT_SITE_GUIDE_GEMINI_MODEL=gemini-2.5-flash
# EUADOPT_SITE_GUIDE_RATE_LIMIT=30

# Securitate autentificare (rate-limit per IP, cache Django)
# AUTH_LOGIN_RATE_LIMIT_PER_15MIN=15
# AUTH_FORGOT_PASSWORD_RATE_LIMIT_PER_HOUR=5
# Restricție /admin/ la IP-uri (virgulă). Gol = fără restricție.
# EUADOPT_ADMIN_ALLOW_IP=xxx.xxx.xxx.xxx
